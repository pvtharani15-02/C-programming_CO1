#include <stdio.h>

#define RATE1 0
#define RATE2 225
#define RATE3 450
#define FIXED 5000L

long long calculate_bill(int units)
{
    long long bill = FIXED;

    if (units > 100)
        bill += (units > 200 ? 100 : units - 100) * RATE2;

    if (units > 200)
        bill += (long long)(units - 200) * RATE3;

    return bill;
}

int main()
{
    int units;

    printf("Enter Units: ");
    scanf("%d", &units);

    if (units < 0)
    {
        printf("Invalid Units\n");
        return 1;
    }

    long long bill = calculate_bill(units);

    printf("Total Bill = Rs %lld.%02lld\n",
           bill / 100, bill % 100);

    return 0;
}
