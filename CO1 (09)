#include <stdio.h>

#define RATE1 0
#define RATE2 225
#define RATE3 450
#define FIXED 5000

unsigned int consumption(unsigned short previous,
                         unsigned short current)
{
    return (unsigned short)(current - previous);
}

long calculate_bill(int units)
{
    long bill = FIXED;

    if (units > 100)
    {
        int slab2 = units > 200 ? 100 : units - 100;
        bill += slab2 * RATE2;
    }

    if (units > 200)
        bill += (units - 200) * RATE3;

    return bill;
}

int main()
{
    unsigned short previous, current;
    unsigned int units;
    long bill;

    printf("Enter Previous Reading: ");

    if (scanf("%hu", &previous) != 1)
        return 1;

    printf("Enter Current Reading: ");

    if (scanf("%hu", &current) != 1)
        return 1;

    units = consumption(previous, current);
    bill = calculate_bill(units);

    printf("Units Consumed: %u\n", units);
    printf("Total Bill: Rs %ld.%02ld\n",
           bill / 100, bill % 100);

    return 0;
}
