#include <stdio.h>

int main()
{
    int bills[] = {5000, 16250, 27500, 95000, 5000};

    long long total = 0;

    for (int i = 0; i < 5; i++)
    {
        total += bills[i];
    }

    printf("Total Paise = %lld\n", total);

    printf("Total Rupees = Rs %lld.%02lld\n",
           total / 100, total % 100);

    return 0;
}
